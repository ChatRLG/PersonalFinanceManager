<Window x:Class="PersonalFinanceManager.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PersonalFinanceManager.Desktop.Views"
        xmlns:vm="clr-namespace:PersonalFinanceManager.Desktop.ViewModels"
        Title="Personal Finance Manager"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <!-- DataTemplates: map ViewModel type → View -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountListViewModel}">
            <views:AccountListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionListViewModel}">
            <views:TransactionListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetListViewModel}">
            <views:BudgetListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Side Nav ─────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,32">
                    <TextBlock Text="💰 PFM" FontSize="20" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding UserName}" FontSize="11"
                               Foreground="#CDD5FF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status badge -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,12"
                        Background="#2F4AC0" CornerRadius="4" Padding="10,6">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="#CDD5FF" TextWrapping="Wrap"/>
                </Border>

                <!-- Logout -->
                <Button DockPanel.Dock="Bottom" Content="⬛ Sign Out"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource NavButton}"
                        Margin="8,0,8,8"/>

                <!-- Nav links -->
                <StackPanel Margin="8,0">
                    <Button Content="📊  Dashboard" Command="{Binding NavDashboardCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="🏦  Accounts" Command="{Binding NavAccountsCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="💳  Transactions" Command="{Binding NavTransactionsCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="📁  Budgets" Command="{Binding NavBudgetsCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="📈  Reports" Command="{Binding NavReportsCommand}"
                            Style="{StaticResource NavButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Content area ──────────────────────────────────────── -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="24,24,24,24"/>
    </Grid>
</Window>
