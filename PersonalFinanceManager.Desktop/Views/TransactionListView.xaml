<UserControl x:Class="PersonalFinanceManager.Desktop.Views.TransactionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Header row -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Transactions" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6C757D"
                           Text="{Binding TotalCount, StringFormat=\{0\} total}" Margin="0,0,16,0"/>
                <Button Content="+ New" Command="{Binding ShowCreateFormCommand}"
                        Style="{StaticResource PrimaryButton}" Height="32"/>
            </StackPanel>
        </DockPanel>

        <!-- Error -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"/>

        <!-- Create form -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding ShowCreateForm, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="New Transaction" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="12"/>
                        <ColumnDefinition/><ColumnDefinition Width="12"/>
                        <ColumnDefinition/><ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Amount" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Type" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TransactionTypes}"
                                  SelectedItem="{Binding NewType}" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Date" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding NewDate}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Category" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedValuePath="Id" SelectedValue="{Binding NewCategoryId}"
                                  DisplayMemberPath="Name" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Description" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormInput}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save" Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButton}" Width="80" Height="32"/>
                    <Button Content="Cancel" Command="{Binding CancelCreateCommand}"
                            Style="{StaticResource SecondaryButton}" Width="80" Height="32" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Pagination -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="← Prev" Command="{Binding PrevPageCommand}"
                    Style="{StaticResource SecondaryButton}" Height="28" Padding="10,4"/>
            <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="12">
                <Run Text="Page "/>
                <Run Text="{Binding CurrentPage}"/>
                <Run Text=" of "/>
                <Run Text="{Binding TotalPages}"/>
            </TextBlock>
            <Button Content="Next →" Command="{Binding NextPageCommand}"
                    Style="{StaticResource SecondaryButton}" Height="28" Padding="10,4"/>
        </StackPanel>

        <!-- Data grid -->
        <DataGrid ItemsSource="{Binding Transactions}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" RowHeight="34" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="100"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="130"/>
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="110"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="100"/>
                <DataGridTemplateColumn Header="" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}" Height="22" Padding="6,0" FontSize="11"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
