<Window x:Class="PersonalFinanceManager.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Finance Manager — Sign In"
        Width="420" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="48,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo / Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32" HorizontalAlignment="Center">
            <TextBlock Text="💰" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="Personal Finance Manager" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="Sign in to your account" FontSize="13" Foreground="#6C757D"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Email -->
        <TextBlock Grid.Row="1" Text="Email" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="10,8" Margin="0,0,0,16"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

        <!-- Password -->
        <TextBlock Grid.Row="3" Text="Password" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
        <PasswordBox Grid.Row="4" x:Name="PasswordBox"
                     FontSize="14" Padding="10,8" Margin="0,0,0,24"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <!-- Error message -->
        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"/>

        <!-- Sign in button -->
        <Button Grid.Row="6"
                Content="{Binding IsBusy, Converter={StaticResource BusyConverter}, ConverterParameter='Signing in...|Sign In'}"
                Command="{Binding LoginCommand}"
                Style="{StaticResource PrimaryButton}"
                Height="40" FontSize="14"/>
    </Grid>
</Window>
