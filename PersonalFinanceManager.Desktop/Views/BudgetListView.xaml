<UserControl x:Class="PersonalFinanceManager.Desktop.Views.BudgetListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Budgets" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="+ New Budget" Command="{Binding ShowCreateFormCommand}"
                    Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Height="32"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"/>

        <!-- Create form -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding ShowCreateForm, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="New Budget" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="12"/>
                        <ColumnDefinition/><ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Limit" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Period" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding NewPeriod}"
                                  Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding NewStartDate}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End Date" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding NewEndDate}" FontSize="13"/>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Category" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedValuePath="Id" SelectedValue="{Binding NewCategoryId}"
                              DisplayMemberPath="Name" Padding="8,6" FontSize="13"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Create" Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButton}" Width="80" Height="32"/>
                    <Button Content="Cancel" Command="{Binding CancelCreateCommand}"
                            Style="{StaticResource SecondaryButton}" Width="80" Height="32" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Budget cards -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Budgets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerButton}" Height="24" Padding="8,0"
                                        VerticalAlignment="Top"/>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="#6C757D">
                                            <Run Text="{Binding CurrentSpend, StringFormat=C}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding Limit, StringFormat=C}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding PercentageUsed}" Maximum="100"
                                                 Height="8" Margin="0,6,0,4"
                                                 Foreground="{StaticResource PrimaryBrush}"/>
                                    <DockPanel>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="#6C757D"/>
                                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#6C757D">
                                            <Run Text="{Binding Remaining, StringFormat=C}"/>
                                            <Run Text=" remaining"/>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
