@page "/transactions"
@attribute [Authorize]
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject ToastService Toast

<PageTitle>Transactions — PFM</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Transactions</h4>
    <a href="/transactions/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Transaction
    </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Account</label>
                <select class="form-select form-select-sm" @onchange="OnAccountFilterChanged">
                    <option value="">All Accounts</option>
                    @foreach (var acc in _accounts)
                    {
                        <option value="@acc.Id">@acc.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Page Size</label>
                <select class="form-select form-select-sm" @onchange="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ResetFilters">
                    <i class="bi bi-x-circle me-1"></i>Reset
                </button>
            </div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <LoadingSpinner />
}
else if (_pagedResult == null || !_pagedResult.Items.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-receipt display-1 text-muted"></i>
        <h5 class="mt-3 text-muted">No transactions found</h5>
        <a href="/transactions/create" class="btn btn-primary mt-2">Add your first transaction</a>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Account</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in _pagedResult.Items)
                        {
                            <tr>
                                <td class="text-muted small">@txn.TransactionDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="fw-semibold">@txn.Description</span>
                                    @if (!string.IsNullOrEmpty(txn.Notes))
                                    {
                                        <br /><small class="text-muted">@txn.Notes</small>
                                    }
                                </td>
                                <td><small class="text-muted">@txn.CategoryName</small></td>
                                <td><small class="text-muted">@txn.AccountName</small></td>
                                <td>
                                    <span class="badge @GetTypeBadgeClass(txn.Type)">@txn.Type</span>
                                </td>
                                <td class="text-end fw-bold @(txn.Type == "Income" ? "text-success" : "text-danger")">
                                    <CurrencyDisplay Amount="@txn.Amount" Currency="@txn.Currency" />
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmDelete(txn)"
                                            title="Delete transaction">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">
            Showing @((_currentPage - 1) * _pageSize + 1)–@Math.Min(_currentPage * _pageSize, _pagedResult.TotalCount)
            of @_pagedResult.TotalCount transactions
        </small>
        <Pagination CurrentPage="@_currentPage"
                    TotalPages="@_pagedResult.TotalPages"
                    OnPageChanged="@OnPageChanged" />
    </div>
}

<!-- Confirm Delete Dialog -->
<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Transaction"
               Message="@_confirmMessage"
               ConfirmText="Delete"
               OnConfirmed="ExecuteDelete" />

@code {
    private bool _isLoading = true;
    private PagedResultDto<TransactionDto>? _pagedResult;
    private List<AccountDto> _accounts = new();

    private int _currentPage = 1;
    private int _pageSize = 20;
    private Guid? _filterAccountId;

    private ConfirmDialog? _confirmDialog;
    private TransactionDto? _pendingDelete;
    private string _confirmMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var accountResult = await AccountService.GetAllAsync();
        if (accountResult.IsSuccess && accountResult.Data != null)
            _accounts = accountResult.Data;

        await LoadPage();
    }

    private async Task LoadPage()
    {
        _isLoading = true;
        try
        {
            var result = await TransactionService.GetPagedAsync(_filterAccountId, _currentPage, _pageSize);
            if (result.IsSuccess)
                _pagedResult = result.Data;
            else
                Toast.ShowError(result.Message ?? "Failed to load transactions.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error loading transactions: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadPage();
    }

    private async Task OnAccountFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _filterAccountId = Guid.TryParse(val, out var id) ? id : null;
        _currentPage = 1;
        await LoadPage();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
            _pageSize = size;
        _currentPage = 1;
        await LoadPage();
    }

    private async Task ResetFilters()
    {
        _filterAccountId = null;
        _currentPage = 1;
        _pageSize = 20;
        await LoadPage();
    }

    private void ConfirmDelete(TransactionDto txn)
    {
        _pendingDelete = txn;
        _confirmMessage = $"Delete \"{txn.Description}\" ({txn.TransactionDate:MMM dd, yyyy})? This will reverse any balance and budget changes.";
        _confirmDialog?.Show();
    }

    private async Task ExecuteDelete()
    {
        if (_pendingDelete is null) return;
        try
        {
            var result = await TransactionService.DeleteAsync(_pendingDelete.Id);
            if (result.IsSuccess)
            {
                Toast.ShowSuccess("Transaction deleted.");
                await LoadPage();
            }
            else
            {
                Toast.ShowError(result.Message ?? "Delete failed.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _pendingDelete = null;
        }
    }

    private string GetTypeBadgeClass(string type) => type switch
    {
        "Income"   => "bg-success",
        "Expense"  => "bg-danger",
        "Transfer" => "bg-info",
        _          => "bg-secondary"
    };
}
