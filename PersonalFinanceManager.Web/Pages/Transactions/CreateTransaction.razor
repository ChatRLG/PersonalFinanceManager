@page "/transactions/create"
@attribute [Authorize]
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject ICategoryService CategoryService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Add Transaction — PFM</PageTitle>

<div class="row justify-content-center">
	<div class="col-md-7">
		<div class="card border-0 shadow-sm">
			<div class="card-header bg-white">
				<h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add Transaction</h5>
			</div>
			<div class="card-body p-4">
				@if (!string.IsNullOrEmpty(_errorMessage))
				{
					<div class="alert alert-danger">
						<i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
					</div>
				}

				<EditForm Model="_model" OnValidSubmit="HandleSubmit">
					<DataAnnotationsValidator />

					<div class="mb-3">
						<label class="form-label">Transaction Type</label>
						<InputSelect class="form-select" @bind-Value="_model.Type">
							<option value="">— Select —</option>
							<option value="Income">Income</option>
							<option value="Expense">Expense</option>
							<option value="Transfer">Transfer</option>
						</InputSelect>
						<ValidationMessage For="() => _model.Type" class="text-danger small" />
					</div>

					<div class="mb-3">
						<label class="form-label">Description</label>
						<InputText class="form-control" @bind-Value="_model.Description"
						           placeholder="e.g. Weekly groceries" />
						<ValidationMessage For="() => _model.Description" class="text-danger small" />
					</div>

					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label">Amount</label>
							<InputNumber class="form-control" @bind-Value="_model.Amount"
							             placeholder="0.00" />
							<ValidationMessage For="() => _model.Amount" class="text-danger small" />
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">Currency</label>
							<InputSelect class="form-select" @bind-Value="_model.Currency">
								<option value="USD">USD</option>
								<option value="EUR">EUR</option>
								<option value="GBP">GBP</option>
								<option value="LKR">LKR</option>
								<option value="JPY">JPY</option>
							</InputSelect>
						</div>
					</div>

					<div class="mb-3">
						<label class="form-label">
							@(_model.Type == "Transfer" ? "Source Account" : "Account")
						</label>
						<InputSelect class="form-select" @bind-Value="_model.AccountId">
							<option value="">— Select Account —</option>
							@foreach (var account in _accounts.Where(a => a.IsActive))
							{
								<option value="@account.Id">@account.Name (@account.Currency)</option>
							}
						</InputSelect>
						<ValidationMessage For="() => _model.AccountId" class="text-danger small" />
					</div>

					@if (_model.Type == "Transfer")
					{
						<div class="mb-3">
							<label class="form-label">Destination Account</label>
							<InputSelect class="form-select" @bind-Value="_model.DestinationAccountId">
								<option value="">— Select Destination —</option>
								@foreach (var account in _accounts.Where(a => a.IsActive && a.Id != _model.AccountId))
								{
									<option value="@account.Id">@account.Name (@account.Currency)</option>
								}
							</InputSelect>
							<ValidationMessage For="() => _model.DestinationAccountId" class="text-danger small" />
						</div>
					}

					<div class="mb-3">
						<label class="form-label">Category</label>
						<InputSelect class="form-select" @bind-Value="_model.CategoryId">
							<option value="">— Select Category —</option>
							@foreach (var cat in _filteredCategories)
							{
								<option value="@cat.Id">@cat.Name</option>
							}
						</InputSelect>
						<ValidationMessage For="() => _model.CategoryId" class="text-danger small" />
					</div>

					<div class="mb-3">
						<label class="form-label">Transaction Date</label>
						<InputDate class="form-control" @bind-Value="_model.TransactionDate" />
						<ValidationMessage For="() => _model.TransactionDate" class="text-danger small" />
					</div>

					<div class="mb-3">
						<label class="form-label">Notes (optional)</label>
						<InputTextArea class="form-control" @bind-Value="_model.Notes"
						               rows="2" placeholder="Additional notes" />
					</div>

					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-primary flex-fill" disabled="@_isSubmitting">
							@if (_isSubmitting)
							{
								<span class="spinner-border spinner-border-sm me-2"></span>
							}
							<i class="bi bi-check-lg me-1"></i>Save Transaction
						</button>
						<a href="/transactions" class="btn btn-outline-secondary flex-fill">
							<i class="bi bi-x-lg me-1"></i>Cancel
						</a>
					</div>
				</EditForm>
			</div>
		</div>
	</div>
</div>

@code {
	private readonly CreateTransactionModel _model = new() { TransactionDate = DateTime.Today };
	private string? _errorMessage;
	private bool _isSubmitting;
	private List<AccountDto> _accounts = new();
	private List<CategoryDto> _allCategories = new();

	private IEnumerable<CategoryDto> _filteredCategories =>
		string.IsNullOrEmpty(_model.Type)
			? _allCategories
			: _allCategories.Where(c => c.Type == _model.Type || _model.Type == "Transfer");

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var accountTask = AccountService.GetAllAsync();
			var categoryTask = CategoryService.GetAllAsync();

			await Task.WhenAll(accountTask, categoryTask);

			if (accountTask.Result.IsSuccess && accountTask.Result.Data != null)
				_accounts = accountTask.Result.Data;

			if (categoryTask.Result.IsSuccess && categoryTask.Result.Data != null)
				_allCategories = categoryTask.Result.Data;
		}
		catch (Exception ex)
		{
			Toast.ShowError($"Error loading form data: {ex.Message}");
		}
	}

	private async Task HandleSubmit()
	{
		_isSubmitting = true;
		_errorMessage = null;

		try
		{
			var result = await TransactionService.CreateAsync(_model);
			if (result.IsSuccess)
			{
				Toast.ShowSuccess("Transaction added successfully!");
				Navigation.NavigateTo("/transactions");
			}
			else
			{
				_errorMessage = result.Message ?? "Failed to create transaction.";
			}
		}
		catch (Exception ex)
		{
			_errorMessage = $"Error: {ex.Message}";
		}
		finally
		{
			_isSubmitting = false;
		}
	}
}

