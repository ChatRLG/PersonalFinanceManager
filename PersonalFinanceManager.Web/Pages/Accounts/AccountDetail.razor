@page "/accounts/{AccountId:guid}"
@attribute [Authorize]
@inject IAccountService AccountService
@inject ITransactionService TransactionService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Account Details — PFM</PageTitle>

@if (_isLoading)
{
    <LoadingSpinner />
}
else if (_account == null)
{
    <div class="text-center py-5">
        <i class="bi bi-exclamation-circle display-1 text-warning"></i>
        <h5 class="mt-3">Account not found</h5>
        <a href="/accounts" class="btn btn-primary mt-2">Back to Accounts</a>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">@_account.Name</h4>
            <small class="text-muted">@_account.Type &middot; @_account.Currency</small>
        </div>
        <a href="/accounts" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <p class="text-muted small mb-1">Current Balance</p>
                    <h2 class="@(_account.Balance >= 0 ? "text-success" : "text-danger") fw-bold">
                        <CurrencyDisplay Amount="@_account.Balance" Currency="@_account.Currency" />
                    </h2>
                    <span class="badge @(_account.IsActive ? "bg-success" : "bg-secondary") mt-2">
                        @(_account.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0">Account Transactions</h6>
                </div>
                <div class="card-body p-0">
                    @if (_transactions.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var txn in _transactions.Take(10))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span>@txn.Description</span><br />
                                        <small class="text-muted">
                                            @txn.TransactionDate.ToString("MMM dd, yyyy") &middot; @txn.CategoryName
                                        </small>
                                    </div>
                                    <CurrencyDisplay Amount="@txn.Amount"
                                                     Currency="@txn.Currency"
                                                     CssClass="@(txn.Type == "Income" ? "fw-bold text-success" : "fw-bold text-danger")" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <p>No transactions for this account.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid AccountId { get; set; }

    private bool _isLoading = true;
    private AccountDto? _account;
    private List<TransactionDto> _transactions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var accTask = AccountService.GetByIdAsync(AccountId);
            var txnTask = TransactionService.GetByAccountAsync(AccountId);

            await Task.WhenAll(accTask, txnTask);

            if (accTask.Result.IsSuccess && accTask.Result.Data != null)
                _account = accTask.Result.Data;

            if (txnTask.Result.IsSuccess && txnTask.Result.Data != null)
                _transactions = txnTask.Result.Data;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error loading account: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}