@page "/"
@attribute [Authorize]
@inject IAccountService AccountService
@inject ITransactionService TransactionService
@inject IBudgetService BudgetService
@inject ToastService Toast

<PageTitle>Dashboard — PFM</PageTitle>

@if (_isLoading)
{
    <LoadingSpinner Message="Loading dashboard..." />
}
else
{
    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
	    <div class="col-md-3">
		    <div class="card border-0 shadow-sm h-100">
			    <div class="card-body">
				    <div class="d-flex justify-content-between">
					    <div>
						    <p class="text-muted small mb-1">Total Balance</p>
						    <h3 class="fw-bold text-primary">
							    <CurrencyDisplay Amount="@_totalBalance" />
						    </h3>
					    </div>
					    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
						    <i class="bi bi-wallet2 fs-3 text-primary"></i>
					    </div>
				    </div>
			    </div>
		    </div>
	    </div>

	    <div class="col-md-3">
		    <div class="card border-0 shadow-sm h-100">
			    <div class="card-body">
				    <div class="d-flex justify-content-between">
					    <div>
						    <p class="text-muted small mb-1">Monthly Income</p>
						    <h3 class="fw-bold text-success">
							    <CurrencyDisplay Amount="@_monthlyIncome" />
						    </h3>
					    </div>
					    <div class="bg-success bg-opacity-10 rounded-3 p-3">
						    <i class="bi bi-arrow-down-circle fs-3 text-success"></i>
					    </div>
				    </div>
			    </div>
		    </div>
	    </div>

	    <div class="col-md-3">
		    <div class="card border-0 shadow-sm h-100">
			    <div class="card-body">
				    <div class="d-flex justify-content-between">
					    <div>
						    <p class="text-muted small mb-1">Monthly Expenses</p>
						    <h3 class="fw-bold text-danger">
							    <CurrencyDisplay Amount="@_monthlyExpenses" />
						    </h3>
					    </div>
					    <div class="bg-danger bg-opacity-10 rounded-3 p-3">
						    <i class="bi bi-arrow-up-circle fs-3 text-danger"></i>
					    </div>
				    </div>
			    </div>
		    </div>
	    </div>

	    <div class="col-md-3">
		    <div class="card border-0 shadow-sm h-100">
			    <div class="card-body">
				    <div class="d-flex justify-content-between">
					    <div>
						    <p class="text-muted small mb-1">Accounts</p>
						    <h3 class="fw-bold text-info">@_accounts.Count</h3>
					    </div>
					    <div class="bg-info bg-opacity-10 rounded-3 p-3">
						    <i class="bi bi-bank fs-3 text-info"></i>
					    </div>
				    </div>
			    </div>
		    </div>
	    </div>
    </div>

    <div class="row g-4">
        <!-- Accounts Overview -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-bank me-2"></i>Accounts</h6>
                    <a href="/accounts" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (_accounts.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var account in _accounts.Take(5))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi @GetAccountIcon(account.Type) me-2 text-primary"></i>
                                        <span class="fw-semibold">@account.Name</span>
                                        <small class="text-muted ms-2">@account.Type</small>
                                    </div>
                                    <CurrencyDisplay Amount="@account.Balance"
                                                        Currency="@account.Currency"
                                                        CssClass="@(account.Balance >= 0 ? "fw-bold text-success" : "fw-bold text-danger")" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-bank fs-1"></i>
                            <p class="mt-2">No accounts yet</p>
                            <a href="/accounts/create" class="btn btn-primary btn-sm">Create Account</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Transactions -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Recent Transactions</h6>
                    <a href="/transactions" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (_recentTransactions.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var txn in _recentTransactions.Take(7))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi @GetTransactionIcon(txn.Type) me-2 @GetTransactionIconColor(txn.Type)"></i>
                                        <span>@txn.Description</span>
                                        <br />
                                        <small class="text-muted">
                                            @txn.TransactionDate.ToString("MMM dd") &middot; @txn.CategoryName
                                        </small>
                                    </div>
                                    <CurrencyDisplay Amount="@txn.Amount"
                                                     Currency="@txn.Currency"
                                                     CssClass="@(txn.Type == "Income" ? "fw-bold text-success" : "fw-bold text-danger")" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-receipt fs-1"></i>
                            <p class="mt-2">No transactions yet</p>
                            <a href="/transactions/create" class="btn btn-primary btn-sm">Add Transaction</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Progress -->
    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-piggy-bank me-2"></i>Active Budgets</h6>
                    <a href="/budgets" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (_budgets.Any())
                    {
                        <div class="row g-3">
                            @foreach (var budget in _budgets.Take(4))
                            {
                                <div class="col-md-6">
                                    <div class="border rounded p-3">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="fw-semibold">@budget.Name</span>
                                            <span class="badge @(budget.IsExceeded ? "bg-danger" : "bg-success")">
                                                @budget.PercentageUsed%
                                            </span>
                                        </div>
                                        <div class="progress mb-2" style="height: 8px;">
                                            <div class="progress-bar @(budget.IsExceeded ? "bg-danger" : budget.PercentageUsed > 80 ? "bg-warning" : "bg-success")"
                                                 style="width: @Math.Min(budget.PercentageUsed, 100)%"></div>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <small class="text-muted">
                                                <CurrencyDisplay Amount="@budget.CurrentSpend" Currency="@budget.Currency" /> spent
                                            </small>
                                            <small class="text-muted">
                                                of <CurrencyDisplay Amount="@budget.Limit" Currency="@budget.Currency" />
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <p class="mb-2">No active budgets</p>
                            <a href="/budgets/create" class="btn btn-primary btn-sm">Create Budget</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private List<AccountDto> _accounts = new();
    private List<TransactionDto> _recentTransactions = new();
    private List<BudgetDto> _budgets = new();
    private decimal _totalBalance;
    private decimal _monthlyIncome;
    private decimal _monthlyExpenses;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var accountsTask = AccountService.GetAllAsync();
            var transactionsTask = TransactionService.GetRecentAsync(7);
            var budgetsTask = BudgetService.GetActiveAsync();

            await Task.WhenAll(accountsTask, transactionsTask, budgetsTask);

            var accountsResult = accountsTask.Result;
            var transactionsResult = transactionsTask.Result;
            var budgetsResult = budgetsTask.Result;

            if (accountsResult.IsSuccess && accountsResult.Data != null)
            {
                _accounts = accountsResult.Data;
                _totalBalance = _accounts.Where(a => a.IsActive).Sum(a => a.Balance);
            }

            if (transactionsResult.IsSuccess && transactionsResult.Data != null)
            {
                _recentTransactions = transactionsResult.Data;

                var thisMonth = _recentTransactions
                    .Where(t => t.TransactionDate.Month == DateTime.Now.Month
                             && t.TransactionDate.Year == DateTime.Now.Year)
                    .ToList();

                _monthlyIncome = thisMonth.Where(t => t.Type == "Income").Sum(t => t.Amount);
                _monthlyExpenses = thisMonth.Where(t => t.Type == "Expense").Sum(t => t.Amount);
            }

            if (budgetsResult.IsSuccess && budgetsResult.Data != null)
            {
                _budgets = budgetsResult.Data;
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load dashboard: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetAccountIcon(string type) => type switch
    {
        "Checking" => "bi-credit-card",
        "Savings" => "bi-safe",
        "Cash" => "bi-cash-stack",
        "CreditCard" => "bi-credit-card-2-front",
        "Loan" => "bi-file-earmark-text",
        "Investment" => "bi-graph-up-arrow",
        _ => "bi-bank"
    };

    private string GetTransactionIcon(string type) => type switch
    {
        "Income" => "bi-arrow-down-circle-fill",
        "Expense" => "bi-arrow-up-circle-fill",
        "Transfer" => "bi-arrow-left-right",
        _ => "bi-circle"
    };

    private string GetTransactionIconColor(string type) => type switch
    {
        "Income" => "text-success",
        "Expense" => "text-danger",
        "Transfer" => "text-info",
        _ => "text-muted"
    };
}


