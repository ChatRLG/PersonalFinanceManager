@page "/budgets"
@attribute [Authorize]
@inject IBudgetService BudgetService
@inject ToastService Toast

<PageTitle>Budgets — PFM</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-piggy-bank me-2"></i>Budgets</h4>
    <a href="/budgets/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Budget
    </a>
</div>

@if (_isLoading)
{
    <LoadingSpinner />
}
else if (!_budgets.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-piggy-bank display-1 text-muted"></i>
        <h5 class="mt-3 text-muted">No budgets found</h5>
        <a href="/budgets/create" class="btn btn-primary mt-2">Create your first budget</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var budget in _budgets)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold mb-0">@budget.Name</h6>
                                <small class="text-muted">@budget.CategoryName &middot; @budget.Period</small>
                            </div>
                            <span class="badge @(budget.IsActive ? (budget.IsExceeded ? "bg-danger" : "bg-success") : "bg-secondary")">
                                @if (!budget.IsActive)
                                {
                                    @:Inactive
                                }
                                else if (budget.IsExceeded)
                                {
                                    @:Exceeded
                                }
                                else
                                {
                                    @:On Track
                                }
                            </span>
                        </div>

                        <div class="my-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="text-muted">
                                    <CurrencyDisplay Amount="@budget.CurrentSpend" Currency="@budget.Currency" /> spent
                                </small>
                                <small class="fw-semibold">@budget.PercentageUsed%</small>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar @GetProgressBarClass(budget)"
                                     role="progressbar"
                                     style="width: @Math.Min(budget.PercentageUsed, 100)%"
                                     aria-valuenow="@budget.PercentageUsed"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <small class="text-muted d-block">Limit</small>
                                <span class="fw-semibold">
                                    <CurrencyDisplay Amount="@budget.Limit" Currency="@budget.Currency" />
                                </span>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Remaining</small>
                                <span class="fw-semibold @(budget.Remaining >= 0 ? "text-success" : "text-danger")">
                                    <CurrencyDisplay Amount="@budget.Remaining" Currency="@budget.Currency" />
                                </span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted">
                                <i class="bi bi-calendar me-1"></i>
                                @budget.StartDate.ToString("MMM dd") — @budget.EndDate.ToString("MMM dd, yyyy")
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-danger flex-fill"
                                    @onclick="() => ConfirmDelete(budget)">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<ConfirmDialog @ref="_confirmDialog"
               Title="Delete Budget"
               Message="@_confirmMessage"
               ConfirmText="Delete"
               OnConfirmed="ExecuteDelete" />

@code {
    private bool _isLoading = true;
    private List<BudgetDto> _budgets = new();

    private ConfirmDialog? _confirmDialog;
    private BudgetDto? _pendingDelete;
    private string _confirmMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBudgets();
    }

    private async Task LoadBudgets()
    {
        _isLoading = true;
        try
        {
            var result = await BudgetService.GetAllAsync();
            if (result.IsSuccess && result.Data != null)
                _budgets = result.Data;
            else
                Toast.ShowError(result.Message ?? "Failed to load budgets.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ConfirmDelete(BudgetDto budget)
    {
        _pendingDelete = budget;
        _confirmMessage = $"Delete budget \"{budget.Name}\"? This cannot be undone.";
        _confirmDialog?.Show();
    }

    private async Task ExecuteDelete()
    {
        if (_pendingDelete is null) return;
        try
        {
            var result = await BudgetService.DeleteAsync(_pendingDelete.Id);
            if (result.IsSuccess)
            {
                Toast.ShowSuccess($"Budget '{_pendingDelete.Name}' deleted.");
                await LoadBudgets();
            }
            else
            {
                Toast.ShowError(result.Message ?? "Delete failed.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _pendingDelete = null;
        }
    }

    private string GetProgressBarClass(BudgetDto budget)
    {
        if (budget.IsExceeded) return "bg-danger";
        if (budget.PercentageUsed > 80) return "bg-warning";
        if (budget.PercentageUsed > 50) return "bg-info";
        return "bg-success";
    }
}
