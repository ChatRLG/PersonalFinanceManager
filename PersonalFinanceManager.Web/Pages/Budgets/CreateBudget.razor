@page "/budgets/create"
@attribute [Authorize]
@inject IBudgetService BudgetService
@inject ICategoryService CategoryService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Create Budget — PFM</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Create Budget</h5>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Budget Name</label>
                        <InputText class="form-control" @bind-Value="_model.Name"
                                   placeholder="e.g. Monthly Groceries" />
                        <ValidationMessage For="() => _model.Name" class="text-danger small" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Limit</label>
                            <InputNumber class="form-control" @bind-Value="_model.Limit"
                                         placeholder="0.00" />
                            <ValidationMessage For="() => _model.Limit" class="text-danger small" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Currency</label>
                            <InputSelect class="form-select" @bind-Value="_model.Currency">
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                                <option value="GBP">GBP</option>
                                <option value="LKR">LKR</option>
                                <option value="JPY">JPY</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <InputSelect class="form-select" @bind-Value="_model.CategoryId">
                            <option value="">— Select Category —</option>
                            @foreach (var cat in _expenseCategories)
                            {
                                <option value="@cat.Id">@(cat.Icon ?? "") @cat.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _model.CategoryId" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Period</label>
                        <InputSelect class="form-select" @bind-Value="_model.Period">
                            <option value="">— Select —</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly">Monthly</option>
                            <option value="Quarterly">Quarterly</option>
                            <option value="Yearly">Yearly</option>
                        </InputSelect>
                        <ValidationMessage For="() => _model.Period" class="text-danger small" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date</label>
                            <InputDate class="form-control" @bind-Value="_model.StartDate" />
                            <ValidationMessage For="() => _model.StartDate" class="text-danger small" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">End Date</label>
                            <InputDate class="form-control" @bind-Value="_model.EndDate" />
                            <ValidationMessage For="() => _model.EndDate" class="text-danger small" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill" disabled="@_isSubmitting">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Create
                        </button>
                        <a href="/budgets" class="btn btn-outline-secondary flex-fill">Cancel</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
	private readonly CreateBudgetModel _model = new()
	{
		StartDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
		EndDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1)
	};
	private string? _errorMessage;
	private bool _isSubmitting;
	private List<CategoryDto> _expenseCategories = new();

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var result = await CategoryService.GetAllAsync();
			if (result.IsSuccess && result.Data != null)
			{
				_expenseCategories = result.Data.Where(c => c.Type == "Expense").ToList();
			}
		}
		catch (Exception ex)
		{
			Toast.ShowError($"Error loading categories: {ex.Message}");
		}
	}

	private async Task HandleSubmit()
	{
		_isSubmitting = true;
		_errorMessage = null;

		try
		{
			var result = await BudgetService.CreateAsync(_model);
			if (result.IsSuccess)
			{
				Toast.ShowSuccess($"Budget '{_model.Name}' created!");
				Navigation.NavigateTo("/budgets");
			}
			else
			{
				_errorMessage = result.Message ?? "Failed to create budget.";
			}
		}
		catch (Exception ex)
		{
			_errorMessage = $"Error: {ex.Message}";
		}
		finally
		{
			_isSubmitting = false;
		}
	}
}
