@page "/categories/create"
@attribute [Authorize]
@inject ICategoryService CategoryService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Create Category — PFM</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Create Category</h5>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <InputText class="form-control" @bind-Value="_model.Name"
                                   placeholder="e.g. Groceries" />
                        <ValidationMessage For="() => _model.Name" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <InputSelect class="form-select" @bind-Value="_model.Type">
                            <option value="">— Select —</option>
                            <option value="Income">Income</option>
                            <option value="Expense">Expense</option>
                        </InputSelect>
                        <ValidationMessage For="() => _model.Type" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Icon (optional, emoji or name)</label>
                        <InputText class="form-control" @bind-Value="_model.Icon"
                                   placeholder="e.g. 🛒" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill" disabled="@_isSubmitting">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Create
                        </button>
                        <a href="/categories" class="btn btn-outline-secondary flex-fill">Cancel</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly CreateCategoryModel _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var result = await CategoryService.CreateAsync(_model);
            if (result.IsSuccess)
            {
                Toast.ShowSuccess($"Category '{_model.Name}' created!");
                Navigation.NavigateTo("/categories");
            }
            else
            {
                _errorMessage = result.Message ?? "Failed to create category.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
