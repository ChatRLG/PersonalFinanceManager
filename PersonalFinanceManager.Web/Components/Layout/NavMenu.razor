@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="sidebar bg-dark text-white d-flex flex-column vh-100">
    <!-- Brand -->
    <div class="p-3 border-bottom border-secondary">
        <a class="text-white text-decoration-none fs-5 fw-bold" href="/">
            <i class="bi bi-wallet2 me-2"></i>PFM
        </a>
    </div>

    <!-- Navigation Links -->
    <nav class="flex-grow-1 p-2">
        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link text-white-50 rounded px-3 py-2 mb-1"
                         href="/" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </NavLink>

                <NavLink class="nav-link text-white-50 rounded px-3 py-2 mb-1"
                         href="/accounts">
                    <i class="bi bi-bank me-2"></i>Accounts
                </NavLink>

                <NavLink class="nav-link text-white-50 rounded px-3 py-2 mb-1"
                         href="/transactions">
                    <i class="bi bi-arrow-left-right me-2"></i>Transactions
                </NavLink>

                <NavLink class="nav-link text-white-50 rounded px-3 py-2 mb-1"
                         href="/categories">
                    <i class="bi bi-tags me-2"></i>Categories
                </NavLink>

                <NavLink class="nav-link text-white-50 rounded px-3 py-2 mb-1"
                         href="/budgets">
                    <i class="bi bi-piggy-bank me-2"></i>Budgets
                </NavLink>

                <NavLink class="nav-link text-white-50 rounded px-3 py-2 mb-1"
                         href="/reports">
                    <i class="bi bi-graph-up me-2"></i>Reports
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <!-- User Section -->
    <div class="p-3 border-top border-secondary">
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-person-circle fs-4 me-2"></i>
                    <small class="text-white-50">@context.User.Identity?.Name</small>
                </div>
                <button class="btn btn-outline-light btn-sm w-100" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </Authorized>
            <NotAuthorized>
                <NavLink class="btn btn-primary btn-sm w-100" href="/login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
