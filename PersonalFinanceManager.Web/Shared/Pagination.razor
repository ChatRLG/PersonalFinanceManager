@if (TotalPages > 1)
{
	<nav aria-label="Page navigation">
		<ul class="pagination justify-content-center">
			<li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
				<button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(CurrentPage - 1)">
					<i class="bi bi-chevron-left"></i>
				</button>
			</li>

			@for (var i = StartPage; i <= EndPage; i++)
			{
				var page = i;
				<li class="page-item @(page == CurrentPage ? "active" : "")">
					<button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(page)">
						@page
					</button>
				</li>
			}

			<li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
				<button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(CurrentPage + 1)">
					<i class="bi bi-chevron-right"></i>
				</button>
			</li>
		</ul>
	</nav>
}

@code {
	[Parameter, EditorRequired] public int CurrentPage { get; set; }
	[Parameter, EditorRequired] public int TotalPages { get; set; }
	[Parameter] public EventCallback<int> OnPageChanged { get; set; }

	private int StartPage => Math.Max(1, CurrentPage - 2);
	private int EndPage => Math.Min(TotalPages, CurrentPage + 2);
}