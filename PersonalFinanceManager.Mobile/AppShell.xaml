<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PersonalFinanceManager.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PersonalFinanceManager.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="PFM — Finance Manager">

    <TabBar>
        <ShellContent
            Title="Dashboard"
            Route="DashboardPage"
            ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent
            Title="Accounts"
            Route="AccountListPage"
            ContentTemplate="{DataTemplate views:AccountListPage}" />
        <ShellContent
            Title="Transactions"
            Route="TransactionListPage"
            ContentTemplate="{DataTemplate views:TransactionListPage}" />
        <ShellContent
            Title="Budgets"
            Route="BudgetListPage"
            ContentTemplate="{DataTemplate views:BudgetListPage}" />
        <ShellContent
            Title="Reports"
            Route="ReportsPage"
            ContentTemplate="{DataTemplate views:ReportsPage}" />
    </TabBar>

</Shell>
